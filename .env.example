# zipmi environment configuration. Copy to .env (gitignored) and edit.
# Loaded automatically by examples/ and the CLI when present.

ZIPMI_TARGET=192.168.0.23
ZIPMI_USER=root
ZIPMI_PASS=calvin

# Set to 1 to enable live integration tests (otherwise skipped).
ZIPMI_LIVE=0

# Set to 1 to allow destructive tests (chassis power, sel clear, etc).
ZIPMI_ALLOW_WRITE=0
